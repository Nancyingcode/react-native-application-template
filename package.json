{
  "name": "react-native-white-label-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "npm run brand:generate && tsx scripts/run-android.ts",
    "ios": "npm run brand:generate && react-native run-ios",
    "brand:generate": "tsx scripts/generate-brand.ts",
    "brand:validate": "tsx scripts/validate-brands.ts",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-nitro-image": "0.15.1",
    "react-native-nitro-modules": "0.36.5",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-vision-camera": "5.2.2",
    "react-native-vision-camera-barcode-scanner": "5.2.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/jest-preset": "0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "tsx": "^4.23.12",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
